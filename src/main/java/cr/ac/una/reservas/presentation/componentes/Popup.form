<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="cr.ac.una.reservas.presentation.componentes.Popup">
  <grid id="p0" binding="pnlContenidoPopup" layout-manager="GridLayoutManager" row-count="3" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="12">
    <margin top="20" left="20" bottom="16" right="20"/>
    <constraints>
      <xy x="20" y="20" width="380" height="180"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="p1" class="javax.swing.JLabel" binding="lblIconoPopup">
        <constraints>
          <grid row="0" column="0" row-span="2" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value=""/>
        </properties>
      </component>
      <component id="p2" class="javax.swing.JLabel" binding="lblTituloPopup">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Titulo"/>
        </properties>
      </component>
      <component id="p3" class="javax.swing.JLabel" binding="lblMensajePopup">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Mensaje"/>
        </properties>
      </component>
      <component id="p4" class="javax.swing.JPanel" binding="pnlBotonesPopup" custom-create="true">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="6" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
    </children>
  </grid>
</form>
